<?php /** @var $block \Vindi\VP\Block\Info\CardCard */ ?>
<?php
$info = $block->getInfo();
$card1Info = $block->getCard1Info();
$card2Info = $block->getCard2Info();
$paymentStatus = $block->getPaymentStatus();
?>
<div class="payment-method-cardcard">
    <div class="payment-method-title">
        <strong><?= $block->escapeHtml(__('Payment Method')) ?>:</strong> <?= $block->escapeHtml(__('Card + Card')) ?>
    </div>
    
    <?php if ($paymentStatus): ?>
        <div class="payment-status">
            <strong><?= $block->escapeHtml(__('Status')) ?>:</strong> 
            <?= $block->escapeHtml($block->formatPaymentStatus($paymentStatus)) ?>
        </div>
    <?php endif; ?>

    <?php if ($card1Info['tid'] || $card1Info['status']): ?>
        <div class="card-info card1-info">
            <h4><?= $block->escapeHtml(__('First Card')) ?></h4>
            
            <?php if ($card1Info['tid']): ?>
                <div><strong><?= $block->escapeHtml(__('Transaction ID')) ?>:</strong> <?= $block->escapeHtml($card1Info['tid']) ?></div>
            <?php endif; ?>
            
            <?php if ($card1Info['status']): ?>
                <div><strong><?= $block->escapeHtml(__('Status')) ?>:</strong> <?= $block->escapeHtml($card1Info['status']) ?></div>
            <?php endif; ?>
            
            <?php if ($card1Info['installments']): ?>
                <div><strong><?= $block->escapeHtml(__('Installments')) ?>:</strong> <?= $block->escapeHtml($card1Info['installments']) ?>x</div>
            <?php endif; ?>
            
            <?php if ($card1Info['amount']): ?>
                <div><strong><?= $block->escapeHtml(__('Amount')) ?>:</strong> R$ <?= $block->escapeHtml(number_format((float)$card1Info['amount'], 2, ',', '.')) ?></div>
            <?php endif; ?>
        </div>
    <?php endif; ?>

    <?php if ($card2Info['tid'] || $card2Info['status']): ?>
        <div class="card-info card2-info">
            <h4><?= $block->escapeHtml(__('Second Card')) ?></h4>
            
            <?php if ($card2Info['tid']): ?>
                <div><strong><?= $block->escapeHtml(__('Transaction ID')) ?>:</strong> <?= $block->escapeHtml($card2Info['tid']) ?></div>
            <?php endif; ?>
            
            <?php if ($card2Info['status']): ?>
                <div><strong><?= $block->escapeHtml(__('Status')) ?>:</strong> <?= $block->escapeHtml($card2Info['status']) ?></div>
            <?php endif; ?>
            
            <?php if ($card2Info['installments']): ?>
                <div><strong><?= $block->escapeHtml(__('Installments')) ?>:</strong> <?= $block->escapeHtml($card2Info['installments']) ?>x</div>
            <?php endif; ?>
            
            <?php if ($card2Info['amount']): ?>
                <div><strong><?= $block->escapeHtml(__('Amount')) ?>:</strong> R$ <?= $block->escapeHtml(number_format((float)$card2Info['amount'], 2, ',', '.')) ?></div>
            <?php endif; ?>
        </div>
    <?php else: ?>
        <div class="card-info card2-info">
            <h4><?= $block->escapeHtml(__('Second Card')) ?></h4>
            <div><strong><?= $block->escapeHtml(__('Status')) ?>:</strong> <?= $block->escapeHtml(__('Pending Processing')) ?></div>
        </div>
    <?php endif; ?>
</div>

