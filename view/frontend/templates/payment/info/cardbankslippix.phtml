    margin: 15px 0 10px 0;
    color: #666;
}

.vindi-vp-cardbankslippix .status-success {
    color: #4caf50;
    font-weight: bold;
}

.vindi-vp-cardbankslippix .status-error {
    color: #f44336;
    font-weight: bold;
}

.vindi-vp-cardbankslippix .status-pending {
    color: #ff9800;
    font-weight: bold;
}

.vindi-vp-cardbankslippix .bankslip-section,
.vindi-vp-cardbankslippix .pix-section {
    margin-top: 15px;
